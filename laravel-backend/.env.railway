APP_NAME="MinSU Business Center"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-laravel-app.up.railway.app

DB_CONNECTION=mysql
DB_HOST=${MYSQLHOST}
DB_PORT=${MYSQLPORT}
DB_DATABASE=${MYSQLDATABASE}
DB_USERNAME=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

SANCTUM_STATEFUL_DOMAINS=your-react-app.up.railway.app
CORS_ALLOWED_ORIGINS=https://your-react-app.up.railway.app

LOG_CHANNEL=stderr
LOG_LEVEL=error
